<package format="3">
  <name>rosa_msgs</name>
  <version>2.0.0</version>
  <description>rosa_msgs</description>
  <maintainer email="yuren.li@ubtrobot.com">Yuren Li</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <buildtool_depend condition="$ROSA_VERSION != 2">rosidl_default_generators</buildtool_depend>

  <depend condition="$ROSA_VERSION == 2">umsgs</depend>
  <depend>std_msgs</depend>

  <exec_depend condition="$ROSA_VERSION != 2">rosidl_default_runtime</exec_depend>
  <member_of_group condition="$ROSA_VERSION != 2">rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>


</package>
